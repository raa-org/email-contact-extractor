{
  "name": "contact-extractor",
  "version": "1.1.0",
  "private": true,
  "description": "Extract business contacts from an IMAP mailbox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raa-org/email-contact-extractor.git"
  },
  "bugs": {
    "url": "https://github.com/raa-org/email-contact-extractor/issues"
  },
  "main": "out/main/index.js",
  "author": {
    "name": "Right&Above, LLC",
    "url": "https://rightandabove.com"
  },
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "scripts": {
    "dev": "electron-rebuild --only better-sqlite3 && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,html,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,html,css,yml,yaml}\"",
    "pretest": "npm run rebuild:node --silent",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prebench:micro": "npm run rebuild:node --silent",
    "bench:micro": "vitest run --config vitest.bench.config.ts benchmarks/aggregate.bench.ts",
    "prebench:e2e": "npm run rebuild:node --silent",
    "bench:e2e": "vitest run --config vitest.bench.config.ts benchmarks/scan-e2e.bench.ts",
    "dist": "npm run build && electron-builder",
    "dist:all": "npm run build && electron-builder -mw",
    "rebuild:electron": "electron-rebuild --only better-sqlite3 --force",
    "rebuild:node": "npm rebuild better-sqlite3 --build-from-source"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "csv-parse": "^6.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-data-grid": "^9.0.4",
    "@reduxjs/toolkit": "^2.11.2",
    "better-sqlite3": "^12.9.0",
    "csv-stringify": "^6.7.0",
    "electron-log": "^5.4.3",
    "exceljs": "^4.4.0",
    "imapflow": "^1.3.2",
    "mailparser": "^3.9.8",
    "react-redux": "^9.2.0",
    "react-router": "^7.14.2",
    "redux-observable": "^3.0.0-rc.3",
    "rxjs": "^7.8.2",
    "typesafe-actions": "^5.1.0",
    "zod": "^4.3.6"
  },
  "homepage": "https://rightandabove.com"
}
